    {
      "name": "Host lists question sets.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is a list containing the created set\", function () {\r\n  const sets = pm.response.json();\r\n  pm.expect(sets).to.be.an(\"array\");\r\n\r\n  const setId = String(pm.collectionVariables.get(\"setId\"));\r\n  pm.expect(\r\n    sets.some((set) => String(set.question_set_id) === setId)\r\n  ).to.be.true;\r\n});"
            ]
          }
        }
